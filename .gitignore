# ============================================================
#  安全管理数据工作台 — Git 忽略规则
# ============================================================

# ---------- 业务数据（重要！不要提交真实数据）----------
# data/ 目录存放实际业务数据，包含人员姓名、事故描述、
# 医疗费用、承包商联系方式等敏感信息，不应进入公开仓库。
# 首次使用时运行 `python app/seed.py` 生成演示数据即可。
data/*.json
data/backup/
data/**/*.tmp

# 保留目录结构（空目录占位文件可提交）
!data/.gitkeep

# ---------- 生成的报表 ----------
reports/
*.xlsx
*.xls
!docs/**/*.xlsx

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/

# ---------- 编辑器与系统 ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志与临时文件 ----------
*.log
*.tmp
*.bak
*.broken-*

# ---------- 本地配置 ----------
config.local.*
*.local.json
