# ============================================================
#  安全管理数据工作台 — Git 忽略规则
# ============================================================

# ---------- 业务数据 ----------
# data/ 用于本地存放业务数据（网页版不用它，数据在浏览器里）
data/*.json
data/backup/
data/**/*.tmp
!data/.gitkeep

# ---------- 静态版数据包 ----------
# web/data/bundle.js 需要提交（GitHub Pages 靠它提供初始数据）
# 生成时注意：公开仓库请用 --demo 生成演示数据
!web/data/bundle.js

# ---------- 生成的报表 ----------
reports/
*.xlsx
*.xls
!docs/**/*.xlsx

# ---------- Node ----------
node_modules/
package-lock.json
.npm/
*.log

# ---------- 编辑器与系统 ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------- 临时文件 ----------
*.tmp
*.bak
*.broken-*

# ---------- 本地配置 ----------
config.local.*
*.local.json

# ---------- Python（已移除，防止误提交）----------
__pycache__/
*.py[cod]
